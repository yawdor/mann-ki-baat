---
import { t, type Lang } from '../lib/i18n';
import { AUDIENCE_COLOURS, audienceLabel } from '../lib/episode-view';
import type { Scheme } from '../lib/schema';

/** Search box + audience chips, driven by src/scripts/schemes.ts (filters `[data-scheme]` inside #scheme-list). */
interface Props { lang: Lang; audiences: Scheme['audiences'] }
const { lang, audiences } = Astro.props;
---
<div class="finder needs-js">
  <label for="scheme-search">{t(lang, 'searchLabel')}</label>
  <div class="search">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--kumkum)" stroke-width="2.2" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /></svg>
    <input id="scheme-search" type="search" placeholder={t(lang, 'searchPlaceholder')} autocomplete="off" aria-controls="scheme-list" />
  </div>
  {audiences.length > 0 && (
    <div class="aud" role="group" aria-label={t(lang, 'searchLabel')}>
      {audiences.map((a) => (
        <button type="button" data-audience={a} aria-pressed="false" style={`--chip: ${AUDIENCE_COLOURS[a]}`}>{audienceLabel(lang, a)}</button>
      ))}
    </div>
  )}
</div>

<style>
  .finder {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: var(--chandan);
    border-radius: var(--radius-card);
    padding: 20px;
  }
  label {
    font-size: 16px;
    font-weight: 700;
    color: var(--kumkum);
  }
  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--white);
    border: 2px solid var(--line-haldi);
    border-radius: var(--radius-button);
    padding: 0 16px;
    min-height: 54px;
  }
  .search:focus-within {
    border-color: var(--peacock);
  }
  input {
    flex: 1;
    border: 0;
    font: 17px var(--font-body);
    background: transparent;
    color: var(--text);
    min-width: 0;
    min-height: 50px;
  }
  input:focus-visible {
    outline: none;
  }
  .aud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .aud button {
    min-height: 40px;
    padding: 0 14px;
    border-radius: var(--radius-pill);
    border: 2px solid var(--chip);
    background: var(--chip);
    color: var(--white);
    font: 600 14px var(--font-body);
    cursor: pointer;
  }
  .aud button[aria-pressed='true'] {
    background: var(--white);
    color: var(--chip);
    box-shadow: inset 0 0 0 2px var(--chip);
  }
  .aud button[aria-pressed='true']::before {
    content: '✓ ';
  }
  @media (max-width: 760px) {
    .finder {
      padding: 0;
      background: transparent;
      gap: 8px;
    }
    label {
      font-size: 15px;
    }
  }
</style>
