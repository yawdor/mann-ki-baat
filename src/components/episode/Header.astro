---
import LanguageMenu from '../LanguageMenu.astro';
import { localePath, t, type Lang } from '../../lib/i18n';

import type { NavItem } from '../../lib/home-paths';

interface Props {
  lang: Lang;
  /** Path below the base, identical in every language, e.g. "/2026-09/" or "/". */
  path: string;
  /** Languages this page exists in. */
  langs: Lang[];
  nav: NavItem[];
  /** Language of the brand (home) link; defaults to `lang`. */
  homeLang?: Lang;
}

const { lang, path, langs, nav, homeLang = lang } = Astro.props;
const site = t(lang, 'siteName');
// "Mann Ki Baat Explained": the last word in marigold, as on the canvas.
const split = lang === 'en' ? site.lastIndexOf(' ') : -1;
const brandA = split > 0 ? site.slice(0, split) : site;
const brandB = split > 0 ? site.slice(split + 1) : '';
const subLang: Lang = lang === 'en' ? 'hi' : lang;
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={localePath(homeLang, '/')} hreflang={homeLang !== lang ? homeLang : undefined}>
      <svg width="46" height="46" viewBox="-50 -50 100 100" aria-hidden="true" focusable="false">
        <g fill="var(--marigold)">
          {[0, 45, 90, 135, 180, 225, 270, 315].map((a) => <ellipse cx="0" cy="-30" rx="9" ry="17" transform={`rotate(${a})`} />)}
        </g>
        <circle r="22" fill="var(--kumkum)" /><circle r="13" fill="var(--haldi)" /><circle r="5" fill="var(--kumkum)" />
      </svg>
      <span class="brand-text">
        <span class="brand-name">{brandA}{brandB && <> <span class="brand-accent">{brandB}</span></>}</span>
        <span class="brand-tag" lang={subLang}>{t(subLang, 'tagline')}</span>
      </span>
    </a>

    <button type="button" class="menu-toggle needs-js" aria-expanded="false" aria-controls="site-nav">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      <span class="visually-hidden">{t(lang, 'menu')}</span>
    </button>

    <nav id="site-nav" class="nav" aria-label={t(lang, 'menu')}>
      {nav.map((n) => <a href={n.href} aria-current={n.current ? 'page' : undefined}>{n.label}</a>)}
    </nav>

    <LanguageMenu lang={lang} path={path} langs={langs} />
  </div>
</header>

<style>
  .site-header {
    background: var(--white);
    position: relative;
    z-index: 20;
  }
  .bar {
    padding-top: 14px;
    padding-bottom: 14px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--kumkum);
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 26px;
  }
  .brand-accent {
    /* Darker than marigold so the large brand text keeps 3:1 contrast on white. */
    color: #C25E00;
  }
  .brand-tag {
    font-size: 14px;
    color: #6B4A2E;
    font-weight: 500;
    margin-top: 2px;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 22px;
    font-size: 16px;
    font-weight: 600;
  }
  .nav a {
    color: var(--text);
    text-decoration: none;
    padding: 10px 0;
  }
  .nav a[aria-current] {
    color: var(--kumkum);
    text-decoration: underline;
    text-decoration-color: var(--haldi);
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }
  .nav a:hover {
    color: var(--kumkum);
  }
  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 2px solid var(--haldi);
    border-radius: 12px;
    background: #FFF8E1;
    color: var(--kumkum);
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  @media (max-width: 760px) {
    .bar {
      padding-top: 12px;
      padding-bottom: 12px;
      flex-wrap: nowrap;
    }
    .brand {
      gap: 10px;
      min-width: 0;
    }
    .brand svg {
      width: 38px;
      height: 38px;
      flex: none;
    }
    .brand-name {
      font-size: 21px;
    }
    .brand-tag {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
      flex: none;
    }
    /* With JS the nav collapses behind the menu button; without JS it stays visible below the bar. */
    .nav {
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      flex-direction: column;
      gap: 0;
      background: var(--white);
      border-bottom: 3px solid var(--haldi);
      padding: 4px 16px 12px;
      box-shadow: 0 12px 24px rgba(122, 20, 49, 0.12);
    }
    :global(html.js) .nav:not(.open) {
      display: none;
    }
    :global(html:not(.js)) .bar {
      flex-wrap: wrap;
    }
    :global(html:not(.js)) .nav {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0 18px;
      box-shadow: none;
      border: 0;
      padding: 0;
      width: 100%;
    }
    .nav a {
      padding: 12px 0;
    }
  }
</style>
