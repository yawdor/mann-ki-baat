---
import { t, type Lang } from '../../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<aside class="machine-notice">
  <div class="wrap inner">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 7.5v5.5M12 16.5v.01" /></svg>
    <p>{t(lang, 'machineNotice')}</p>
  </div>
</aside>

<style>
  .machine-notice {
    background: #FFF8E1;
    border-top: 2px solid var(--haldi);
    border-bottom: 2px solid var(--haldi);
    color: var(--text);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    font-weight: 600;
    font-size: 16px;
  }
  svg {
    flex: none;
    color: var(--rust);
  }
  p {
    margin: 0;
  }
</style>
