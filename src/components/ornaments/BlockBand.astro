---
interface Props { variant: 'haldi' | 'kumkum' }
const { variant } = Astro.props;
const id = `band-${variant}-${crypto.randomUUID().slice(0, 8)}`;
const haldi = variant === 'haldi';
const base = haldi ? 'var(--haldi)' : 'var(--kumkum)';
const edge = haldi ? 'var(--peacock)' : 'var(--haldi)';
const diamond = haldi ? 'var(--kumkum)' : 'var(--marigold)';
const dotMid = haldi ? 'var(--haldi)' : 'var(--kumkum)';
---
<svg width="100%" height="30" aria-hidden="true" focusable="false" data-variant={variant} style="display: block">
  <defs>
    <pattern id={id} width="40" height="30" patternUnits="userSpaceOnUse">
      <rect width="40" height="30" fill={base} />
      <rect width="40" height="4" fill={edge} />
      <rect y="26" width="40" height="4" fill={edge} />
      <path d="M20 7 L31 15 L20 23 L9 15Z" fill={diamond} />
      <circle cx="20" cy="15" r="3" fill={dotMid} />
      <circle cx="0" cy="15" r="3" fill={edge} />
      <circle cx="40" cy="15" r="3" fill={edge} />
    </pattern>
  </defs>
  <rect width="100%" height="30" fill={`url(#${id})`} />
</svg>
