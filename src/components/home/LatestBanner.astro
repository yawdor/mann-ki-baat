---
import Mandala from '../ornaments/Mandala.astro';
import { pick, t, type Lang } from '../../lib/i18n';
import { longDate } from '../../lib/episode-view';
import { episodeLink } from '../../lib/episode-paths';
import type { Episode, Scheme } from '../../lib/schema';

/** Latest-episode banner (canvas Archive board); with no episode, a "coming soon" card. */
interface Props { episode?: Episode; schemes: Map<string, Scheme>; lang: Lang }
const { episode, schemes, lang } = Astro.props;
const link = episode && episodeLink(episode, lang, schemes);
---
<section class="wrap latest-wrap">
  {episode && link ? (
    <a class="latest on-dark" href={link.href} hreflang={link.lang}>
      <span class="copy">
        <span class="badge">
          <span>{t(lang, 'latest')}</span>
          <span aria-hidden="true">·</span>
          <span>{t(lang, 'episode')} {episode.episode}</span>
          <span aria-hidden="true">·</span>
          <time datetime={episode.date}>{longDate(episode.date, lang)}</time>
        </span>
        <h1 class="headline">{pick(episode.title, lang)}</h1>
        <span class="summary">{pick(episode.summary, lang)}</span>
        <span class="cta">{t(lang, 'ctaExplainer')}</span>
      </span>
      <span class="art" aria-hidden="true">
        <span class="glow"><Mandala size={320} motif={episode.theme.motif} /></span>
      </span>
    </a>
  ) : (
    <div class="latest on-dark soon">
      <span class="copy">
        <h1 class="headline">{t(lang, 'siteName')}</h1>
        <span class="summary">{t(lang, 'comingSoon')}</span>
      </span>
      <span class="art" aria-hidden="true">
        <span class="glow"><Mandala size={320} motif="mandala" /></span>
      </span>
    </div>
  )}
</section>

<style>
  .latest-wrap {
    padding-top: 32px;
  }
  .latest {
    display: flex;
    flex-wrap: wrap;
    border-radius: 32px;
    overflow: hidden;
    background: var(--kumkum);
    color: var(--white);
    text-decoration: none;
    box-shadow: 0 0 0 5px var(--haldi);
    /* Keep the ring inside the page so it never causes sideways scroll. */
    margin: 5px;
  }
  a.latest:hover {
    color: var(--white);
  }
  a.latest:hover .cta {
    background: #FFC928;
  }
  a.latest:focus-visible {
    outline-offset: 8px;
  }
  .copy {
    flex: 999 1 520px;
    min-width: 0;
    padding: 56px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .badge {
    align-self: flex-start;
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px 8px;
    background: var(--haldi);
    color: var(--text);
    font-weight: 700;
    font-size: 14px;
    border-radius: var(--radius-pill);
    padding: 4px 16px;
  }
  .badge:lang(en) {
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .headline {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 58px;
    line-height: 1.04;
    overflow-wrap: anywhere;
  }
  .summary {
    color: #FFE7EC;
    font-size: 20px;
  }
  .cta {
    align-self: flex-start;
    margin-top: 8px;
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 26px;
    border-radius: var(--radius-pill);
    background: var(--haldi);
    color: var(--text);
    font-weight: 700;
    box-shadow: 0 4px 0 #B88700;
  }
  .art {
    flex: 1 1 340px;
    min-height: 360px;
    background: var(--peacock);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .glow {
    display: block;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    box-shadow: 0 0 90px 6px color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .glow :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  @media (max-width: 760px) {
    .latest-wrap {
      padding-top: 20px;
    }
    .latest {
      border-radius: 24px;
    }
    .copy {
      padding: 28px 22px;
      gap: 12px;
    }
    .headline {
      font-size: 36px;
    }
    .summary {
      font-size: 17px;
    }
    .art {
      flex-basis: 100%;
      min-height: 220px;
    }
    .glow {
      width: 200px;
      height: 200px;
    }
  }
</style>
