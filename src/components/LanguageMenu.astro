---
import { LANG_META, localePath, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  /** Path below the base, identical in every language, e.g. "/2026-09/" or "/". */
  path: string;
  /** Languages this page exists in. */
  langs: Lang[];
}

const { lang, path, langs } = Astro.props;
const href = (l: Lang) => localePath(l, path);
const machine = langs.filter((l) => LANG_META[l].machine);
const pill = [
  { l: 'en' as Lang, label: 'English' },
  { l: 'hi' as Lang, label: 'हिंदी' },
].filter((p) => langs.includes(p.l));
const browsers = [
  { name: 'Chrome / Android', key: 'translateChrome' as const },
  { name: 'Edge', key: 'translateEdge' as const },
  { name: 'Safari', key: 'translateSafari' as const },
];
---
<div class="lang-switch">
  <div class="pill" role="group" aria-label={t(lang, 'language')}>
    {pill.map((p) => (
      <a
        href={href(p.l)}
        hreflang={p.l}
        lang={p.l}
        data-keep-hash
        aria-current={p.l === lang ? 'page' : undefined}
        class:list={['pill-btn', { on: p.l === lang }]}
      >{p.label}</a>
    ))}
  </div>
  <details class="more">
    <summary>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" /></svg>
      <span>{LANG_META[lang].machine ? LANG_META[lang].nativeName : t(lang, 'moreLanguages')}</span>
    </summary>
    <div class="more-panel">
      {machine.length > 0 && (
        <ul>
          {machine.map((l) => (
            <li>
              <a href={href(l)} hreflang={l} lang={l} data-keep-hash aria-current={l === lang ? 'page' : undefined}>
                {LANG_META[l].nativeName}
              </a>
            </li>
          ))}
        </ul>
      )}
      <details class="other">
        <summary>{t(lang, 'otherLanguages')}</summary>
        <p>{t(lang, 'translateGuide')}</p>
        <dl>
          {browsers.map((b) => (
            <>
              <dt lang="en">{b.name}</dt>
              <dd>{t(lang, b.key)}</dd>
            </>
          ))}
        </dl>
        <p class="small">{t(lang, 'machineNotice')}</p>
      </details>
    </div>
  </details>
</div>

<style>
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .pill {
    display: flex;
    border: 2px solid var(--haldi);
    border-radius: var(--radius-pill);
    padding: 3px;
    background: #FFF8E1;
  }
  .pill-btn {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-pill);
    padding: 6px 16px;
    min-height: 40px;
    color: var(--kumkum);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
  }
  .pill-btn.on {
    background: var(--kumkum);
    color: var(--white);
  }
  .more {
    position: relative;
  }
  .more > summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 6px;
    border: 2px solid var(--peacock);
    background: var(--white);
    border-radius: var(--radius-pill);
    padding: 6px 14px;
    min-height: 44px;
    color: var(--peacock);
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
  }
  .more > summary::-webkit-details-marker {
    display: none;
  }
  .more-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    width: min(320px, calc(100vw - 32px));
    background: var(--white);
    color: var(--text);
    border: 2px solid var(--line-card);
    border-radius: 18px;
    box-shadow: 0 12px 28px rgba(122, 20, 49, 0.18);
    padding: 14px 16px;
    font-size: 16px;
  }
  .more-panel ul {
    list-style: none;
    margin: 0 0 12px;
    padding: 0 0 12px;
    border-bottom: 2px dotted var(--line-haldi);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .more-panel li a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border-radius: var(--radius-pill);
    background: #FFF8E1;
    color: var(--kumkum);
    font-weight: 600;
    text-decoration: none;
  }
  .more-panel li a[aria-current] {
    background: var(--kumkum);
    color: var(--white);
  }
  .other p {
    margin: 4px 0 0;
    line-height: 1.45;
  }
  .other .small {
    font-size: 14px;
    color: var(--text-soft);
  }

  .other > summary {
    list-style: none;
    display: flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    color: var(--peacock);
    cursor: pointer;
  }
  .other > summary::-webkit-details-marker {
    display: none;
  }
  .other > summary::after {
    content: '▾';
    margin-left: 6px;
  }
  .other[open] > summary::after {
    content: '▴';
  }
  .other dl {
    margin: 10px 0 0;
  }
  .other dt {
    font-weight: 700;
    font-size: 15px;
    color: var(--kumkum);
  }
  .other dd {
    margin: 0 0 8px;
    font-size: 15px;
    line-height: 1.45;
  }

  @media (max-width: 760px) {
    .lang-switch {
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: 16px;
      z-index: 40;
      gap: 6px;
      background: var(--kumkum);
      border: 3px solid var(--haldi);
      border-radius: var(--radius-pill);
      padding: 5px;
      box-shadow: 0 8px 24px rgba(122, 20, 49, 0.35);
    }
    .lang-switch :focus-visible {
      outline-color: var(--haldi);
    }
    .lang-switch .more-panel :focus-visible {
      outline-color: var(--peacock);
    }
    .pill {
      flex: 2;
      border: 0;
      padding: 0;
      background: transparent;
      gap: 6px;
    }
    .pill-btn {
      flex: 1;
      justify-content: center;
      min-height: 44px;
      color: var(--white);
      padding: 0 8px;
    }
    .pill-btn.on {
      background: var(--haldi);
      color: var(--text);
    }
    .more {
      flex: 1;
      position: static;
    }
    .more > summary {
      justify-content: center;
      border: 0;
      background: transparent;
      color: var(--white);
      min-height: 44px;
      padding: 0 8px;
    }
    .more-panel {
      top: auto;
      bottom: calc(100% + 10px);
      left: 0;
      right: 0;
      width: auto;
      max-height: calc(100vh - 120px);
      overflow-y: auto;
    }
  }
</style>
